{
  "expo": {
    "name": "Anufi",
    "slug": "mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "anufi",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splashicon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anufy.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Anufi to access your camera to take photos and record videos.",
        "NSMicrophoneUsageDescription": "Allow Anufi to access your microphone to record audio and voice messages.",
        "NSPhotoLibraryUsageDescription": "Allow Anufi to access your photo library to select and upload photos and videos.",
        "NSPhotoLibraryAddUsageDescription": "Allow Anufi to save photos and videos to your photo library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#FFFFFF",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_MEDIA_LOCATION",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_AUDIO",
        "READ_MEDIA_VISUAL_USER_SELECTED",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "CAMERA"
      ],
      "package": "com.anufy.app",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splashicon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Anufi to access your photos.",
          "savePhotosPermission": "Allow Anufi to save photos.",
          "videoPermission": "Allow Anufi to access your videos.",
          "isStandard": true,
          "granularPermissions": [
            "photo",
            "video",
            "audio"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "enableProguardInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-video",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-9263147466443083~3186363669",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "android_app_id": "ca-app-pub-9263147466443083~3186363669",
          "ios_app_id": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7127a361-ef48-403a-8412-5c34afd90feb"
      }
    },
    "owner": "anufi",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/7127a361-ef48-403a-8412-5c34afd90feb"
    }
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-9263147466443083~3186363669",
    "ios_app_id": "ca-app-pub-3940256099942544~1458002511",
    "androidAppId": "ca-app-pub-9263147466443083~3186363669",
    "iosAppId": "ca-app-pub-3940256099942544~1458002511"
  }
}